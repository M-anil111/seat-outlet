# This file is only a LIST of the setting names the site understands. Nothing in the PHP reads a .env file.
# Real values go in inc/env.local.php (putenv() lines; copy deploy/env.local.php.example), which is never
# committed and never overwritten by a deploy. On beta/production the same file is created on the server.
# Check the result with:  php tools/check-env.php
# Secrets (passwords, API keys) are also stored as GitHub repository secrets:
# Settings -> Secrets and variables -> Actions.

# --- Database (db/config.php) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# --- TicketNetwork API (inc/constants.php) ---
CONSUMER_KEY=
CONSUMER_SECRET=

# --- Google APIs (inc/constants.php) ---
GAPI_KEY=
GKGSAPI_KEY=

# --- Cloudflare R2 / S3-compatible storage (inc/constants.php, functions.php) ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# --- reCAPTCHA (inc/constants.php, ajax/check-email.php) ---
RECAPTCHA_SECRET_KEY=

# --- Brevo SMTP (newsletter-email.php) ---
SMTP_USER=
SMTP_PASS=

# --- Sentry error monitoring (inc/constants.php, functions.php) ---
# Optional: Sentry is simply not initialized when this is left empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# --- Deploy (GitHub Actions only - not read by the app itself) ---
FTP_HOST=
FTP_USERNAME=
FTP_PASSWORD=

# --- Site and TicketNetwork environment (inc/constants.php). These default to BETA/SANDBOX values when left out. ---
HOME_URL=
BASE_URL=
WEBSITE_CONFIG_ID=
WEBSITE_CONFIG_ID_LIVE=
HOME_PATH=
SITE_INDEXABLE=
GTM_ID=

# --- Email and leads (inc/leads-core.php, inc/lead-mail.php) ---
SMTP_USER=
SMTP_PASS=
SO_MAIL_ADDRESS=
SO_MAIL_FROM=
SO_LEAD_NOTIFY_TO=
BREVO_API_KEY=
BREVO_LIST_ID=
