# Copy this file to .env for local development ONLY (never committed - see .gitignore).
# In production/beta, these are never read from a .env file: the deploy pipeline
# (.github/workflows/deploy.yml) generates inc/env.local.php from GitHub's
# encrypted repository secrets instead.
# Real values live only in GitHub: Settings -> Secrets and variables -> Actions.

# --- Database (db/config.php) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# --- TicketNetwork API (inc/constants.php) ---
CONSUMER_KEY=
CONSUMER_SECRET=

# --- Google APIs (inc/constants.php) ---
GAPI_KEY=
GKGSAPI_KEY=

# --- Cloudflare R2 / S3-compatible storage (inc/constants.php, functions.php) ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# --- reCAPTCHA (inc/constants.php, ajax/check-email.php) ---
RECAPTCHA_SECRET_KEY=

# --- Brevo SMTP (newsletter-email.php) ---
SMTP_USER=
SMTP_PASS=

# --- Sentry error monitoring (inc/constants.php, functions.php) ---
# Optional: Sentry is simply not initialized when this is left empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# --- Deploy (GitHub Actions only - not read by the app itself) ---
FTP_HOST=
FTP_USERNAME=
FTP_PASSWORD=
