<?php
// Copy to inc/env.local.php ON THE SERVER (never commit the real file).
// The deploy script never overwrites it. Leave out any optional line you do not use.
// Check it any time with:  php tools/check-env.php   (lists what is still a beta/sandbox default or missing)

// --- Required secrets ---
putenv('DB_PASS=');
putenv('CONSUMER_KEY=');
putenv('CONSUMER_SECRET=');
putenv('GAPI_KEY=');
putenv('AWS_ACCESS_KEY=');
putenv('AWS_SECRET_KEY=');
putenv('RECAPTCHA_SECRET_KEY=');

// --- Environment: these default to BETA/SANDBOX values when left out. A production server must set all of them. ---
putenv('HOME_URL=');                // https://www.seatoutlet.com  (canonical, sitemap, Open Graph, email links; a beta./staging./localhost value makes the site noindex)
putenv('BASE_URL=');                // https://www.tn-apis.com for the live TicketNetwork API (default: https://sandbox.tn-apis.com)
putenv('WEBSITE_CONFIG_ID=');       // normally leave unset: the live API host selects WEBSITE_CONFIG_ID_LIVE, the sandbox uses 12498
putenv('WEBSITE_CONFIG_ID_LIVE=');  // the live website config id (default 27773)
putenv('DB_HOST=');                 // default 127.0.0.1
putenv('DB_NAME=');                 // default seatoutlet-beta
putenv('DB_USER=');                 // default beta-seatoutlet
putenv('HOME_PATH=');               // absolute path of the web root on this server (default is the beta path)
putenv('SITE_INDEXABLE=');          // 1 on production; normally derived from HOME_URL
putenv('GTM_ID=');                  // GTM-XXXXXXX, empty = no Google Tag Manager
putenv('CRON_TOKEN=');              // only if a host can schedule URLs but not commands; prefer running cron/*.php with php

// --- Email (sign-ups, alerts, admin password reset) ---
putenv('SMTP_USER=');               // Brevo SMTP login
putenv('SMTP_PASS=');               // Brevo SMTP key
putenv('SO_MAIL_ADDRESS=');         // physical mailing address printed in every marketing email footer (US law asks for one), one line
putenv('SO_MAIL_FROM=');            // optional sender address (default support@seatoutlet.com)
putenv('SO_LEAD_NOTIFY_TO=');       // optional: comma separated addresses that get a note for every new sign-up
putenv('BREVO_API_KEY=');           // optional: also add every sign-up to Brevo as a contact
putenv('BREVO_LIST_ID=');           // optional: Brevo list id for those contacts

// --- Optional ---
putenv('SENTRY_DSN=');
putenv('SENTRY_ENVIRONMENT=');
putenv('THESPORTSDB_KEY=');         // default is TheSportsDB's public key
putenv('PEXELS_API_KEY=');
putenv('UNSPLASH_ACCESS_KEY=');     // city photos (Access Key only; the Secret Key is not used)
putenv('MAXMIND_ACCOUNT_ID=');      // geolocation database (cron/geoip-update.php)
putenv('MAXMIND_LICENSE_KEY=');
putenv('GEOIP_DB_PATH=');
putenv('TN_CHECKOUT_URL=');
putenv('TN_TOKEN_DIR=');
putenv('HTML_EDGE_CACHE_SECONDS=');  // default 120, 0 = send no page cache headers
putenv('SO_TRUSTED_PROXIES=');       // extra proxy ranges (comma separated CIDR) whose CF-Connecting-IP header may be believed; Cloudflare is built in
