<?php
// Copy to ~/.seatoutlet/env.local.php ON THE SERVER, as the site user, outside
// htdocs (never commit the real file):
//   mkdir -p ~/.seatoutlet && chmod 700 ~/.seatoutlet
//   cp deploy/env.local.php.example ~/.seatoutlet/env.local.php
//   chmod 600 ~/.seatoutlet/env.local.php
// inc/env.php loads it on every request and cron run; deploys never touch it.
// Check with: php tools/env-check.php
// Leave out any optional line you do not use. DB_HOST/DB_PORT/DB_NAME/DB_USER
// default to 127.0.0.1 / 3306 / seatoutlet-beta / beta-seatoutlet.
putenv('DB_PASS=');
putenv('CONSUMER_KEY=');
putenv('CONSUMER_SECRET=');
putenv('GAPI_KEY=');
putenv('AWS_ACCESS_KEY=');
putenv('AWS_SECRET_KEY=');
putenv('RECAPTCHA_SECRET_KEY=');
// Optional
putenv('SMTP_USER=');
putenv('SMTP_PASS=');
putenv('SENTRY_DSN=');
putenv('THESPORTSDB_KEY=');
putenv('PEXELS_API_KEY=');
putenv('MAXMIND_ACCOUNT_ID=');
putenv('MAXMIND_LICENSE_KEY=');
putenv('GEOIP_DB_PATH=');
putenv('TN_CHECKOUT_URL=');
putenv('GTM_ID=');
putenv('TN_TOKEN_DIR=');
